{
  "name": "token-harness",
  "version": "0.1.0",
  "description": "Token-saving harness for coding agents: context rewrite core, Responses API proxy, agent loop with fork/merge, sidecar tuner.",
  "private": true,
  "type": "module",
  "bin": {
    "th": "bin/th.js",
    "th-proxy": "bin/th-proxy.js",
    "th-sidecar": "bin/th-sidecar.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "proxy": "tsx src/proxy/cli.ts",
    "harness": "tsx src/harness/cli.ts",
    "sidecar": "tsx src/sidecar/cli.ts",
    "bench:replay": "tsx src/bench/replay.ts"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
