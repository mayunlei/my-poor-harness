{
  "name": "my-poor-harness",
  "version": "0.8.0",
  "description": "Token-saving harness for coding agents: context rewrite core, Responses API proxy, agent loop with fork/merge, sidecar tuner, live dashboard.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayunlei/my-poor-harness.git"
  },
  "homepage": "https://github.com/mayunlei/my-poor-harness#readme",
  "bugs": {
    "url": "https://github.com/mayunlei/my-poor-harness/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "llm",
    "tokens",
    "context",
    "codex",
    "openai",
    "responses-api",
    "cli",
    "proxy",
    "prompt-cache"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mph": "bin/mph.js",
    "poor": "bin/mph.js",
    "my-poor-harness": "bin/mph.js"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "proxy": "tsx src/proxy/cli.ts",
    "harness": "tsx src/harness/cli.ts",
    "sidecar": "tsx src/sidecar/cli.ts",
    "dash": "tsx src/dashboard/cli.ts",
    "bench:replay": "tsx src/bench/replay.ts",
    "package": "bash scripts/package.sh",
    "release": "bash scripts/release.sh",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
